# Project NOIR Environment Configuration
NOIR_ENV=development
NOIR_LOG_LEVEL=INFO

# Storage
NOIR_DB_PATH=noir.db
NOIR_EXPERIMENTS_DIR=experiments
NOIR_CHECKPOINTS_DIR=checkpoints
NOIR_LOGS_DIR=logs
NOIR_MEMORY_DIR=memory

# Training & Compute
NOIR_DEVICE=auto
NOIR_NUM_WORKERS=0

# Affective / Mind Engine
NOIR_EMOTION_ENABLED=true
NOIR_SURPRISE_THRESHOLD=0.75
NOIR_CURIOSITY_WEIGHT=0.2

# LLM Strategist & MCP
NOIR_LLM_PROVIDER=local
NOIR_LLM_MODEL=llama3
NOIR_LLM_API_BASE=http://localhost:11434/v1
NOIR_LLM_API_KEY=
NOIR_MCP_ENABLED=true
NOIR_MCP_PORT=8765
